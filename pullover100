##############################################
# Azure DevOps – Get Test Results by Time Window
# Works for Classic Release pipelines
# NOW WITH PAGINATION SUPPORT FOR 100+ RESULTS
##############################################

# ===== CONFIG =====
$org     = "org"
$project = "project"
$pat     = "yourPAT"

# IMPORTANT: UTC timestamps
# 5 hours ahead of EST time.
# whatever timestamp we use -5 hours from it to get the est time.

#$completedAfter  = "2026-01-29T05:00:00Z"
#$completedBefore = "2026-01-30T00:00:00Z"

#ex: above translates to 12am 1/29 to 7pm 1/29

#take ADO servers time, add 6 hours.
#thats how you calculate time frame.

#ADO server is 1 hour behind.
#ADO server is 6 hours behind UTC time.

$completedAfter  = "2026-02-03T00:00:00Z"
$completedBefore = "2026-02-03T08:20:00Z"

# Output file
$outputCsv = "Release_TestResults.csv"

# ===== AUTH HEADER =====
$base64AuthInfo = [Convert]::ToBase64String(
    [Text.Encoding]::ASCII.GetBytes(":$pat")
)

$headers = @{
    Authorization = "Basic $base64AuthInfo"
}

# ===== FUNCTION: GET ALL TEST RUNS WITH PAGINATION =====
function Get-AllTestRuns {
    param(
        [string]$BaseUrl,
        [hashtable]$Headers
    )
    
    $allRuns = @()
    $continuationToken = $null
    $pageCount = 0
    
    do {
        $pageCount++
        Write-Host "  Fetching runs page $pageCount..." -ForegroundColor Yellow
        
        $url = $BaseUrl
        if ($continuationToken) {
            $url += "&continuationToken=$continuationToken"
        }
        
        try {
            $response = Invoke-WebRequest -Uri $url -Headers $Headers -Method Get -UseBasicParsing
            $data = $response.Content | ConvertFrom-Json
            
            if ($data.value) {
                $allRuns += $data.value
                Write-Host "    Retrieved $($data.value.Count) runs (Total: $($allRuns.Count))" -ForegroundColor Green
            }
            
            # Check for continuation token in response headers
            $continuationToken = $response.Headers['x-ms-continuationtoken']
            
        } catch {
            Write-Host "    Error fetching runs: $_" -ForegroundColor Red
            break
        }
        
    } while ($continuationToken)
    
    return $allRuns
}

# ===== FUNCTION: GET ALL RESULTS FOR A RUN WITH PAGINATION =====
function Get-AllTestResultsForRun {
    param(
        [string]$Organization,
        [string]$Project,
        [int]$RunId,
        [hashtable]$Headers
    )
    
    $allResults = @()
    $continuationToken = $null
    $pageCount = 0
    
    do {
        $pageCount++
        
        # Build URL with pagination support
        $url = "https://***/$Organization/$Project/_apis/test/runs/$RunId/results?api-version=6.0&`$top=1000"
        
        if ($continuationToken) {
            $url += "&continuationToken=$continuationToken"
        }
        
        try {
            $response = Invoke-WebRequest -Uri $url -Headers $Headers -Method Get -UseBasicParsing
            $data = $response.Content | ConvertFrom-Json
            
            if ($data.value) {
                $allResults += $data.value
                Write-Host "    Page $pageCount`: Retrieved $($data.value.Count) results (Run total: $($allResults.Count))" -ForegroundColor Cyan
            }
            
            # Check for continuation token
            $continuationToken = $response.Headers['x-ms-continuationtoken']
            
        } catch {
            Write-Host "    Error fetching results for run $RunId`: $_" -ForegroundColor Red
            break
        }
        
    } while ($continuationToken)
    
    return $allResults
}

# ===== QUERY TEST RUNS BY COMPLETION WINDOW ===== 
Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "Querying Test Runs..." -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Time Window: $completedAfter to $completedBefore" -ForegroundColor White

$runsBaseUrl = "https://***/$org/$project/_apis/test/runs" +
               "?minLastUpdatedDate=$completedAfter" +
               "&maxLastUpdatedDate=$completedBefore" +
               "&api-version=6.0&`$top=1000"

# Get all runs with pagination
$allRuns = Get-AllTestRuns -BaseUrl $runsBaseUrl -Headers $headers

Write-Host "`nTotal runs retrieved: $($allRuns.Count)" -ForegroundColor Green

# ===== FILTER COMPLETED + AUTOMATED RUNS =====
$completedRuns = $allRuns | Where-Object {
    $_.state -eq "Completed" -and
    $_.isAutomated -eq $true
}

Write-Host "Completed automated runs: $($completedRuns.Count)" -ForegroundColor Green

# ===== PULL TEST RESULTS PER RUN WITH PAGINATION =====
Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "Fetching Test Results..." -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$allResults = @()
$runCounter = 0

foreach ($run in $completedRuns) {
    $runCounter++
    Write-Host "`n[$runCounter/$($completedRuns.Count)] Processing RunId $($run.id) | $($run.name)" -ForegroundColor Yellow
    
    # Get all results for this run with pagination
    $runResults = Get-AllTestResultsForRun -Organization $org -Project $project -RunId $run.id -Headers $headers
    
    Write-Host "  Total results for this run: $($runResults.Count)" -ForegroundColor Green
    
    # Transform results into output format
    foreach ($result in $runResults) {
        $allResults += [PSCustomObject]@{
            RunId         = $run.id
            RunName       = $run.name
            CompletedDate = $run.completedDate
            TestName      = $result.testCaseTitle
            Outcome       = $result.outcome
            DurationMs    = $result.durationInMs
            ErrorMessage  = $result.errorMessage
            StackTrace    = $result.stackTrace
        }
    }
}

# ===== EXPORT RESULTS =====
Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "Export Summary" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

if ($allResults.Count -gt 0) {
    Write-Host "Total test results collected: $($allResults.Count)" -ForegroundColor Green
    
    # Show outcome breakdown
    $outcomeGroups = $allResults | Group-Object Outcome
    Write-Host "`nOutcome Breakdown:" -ForegroundColor White
    foreach ($group in $outcomeGroups) {
        Write-Host "  $($group.Name): $($group.Count)" -ForegroundColor White
    }
    
    # Export to CSV
    $allResults | Export-Csv $outputCsv -NoTypeInformation
    Write-Host "`nTest results exported to: $outputCsv" -ForegroundColor Green
} else {
    Write-Warning "No test results found in the specified time window."
}

Write-Host "`nDone!" -ForegroundColor Cyan
